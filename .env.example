NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173
# Desarrollo local con Docker:
DATABASE_URL=postgres://glamstudio:glamstudio@localhost:5432/glamstudio
DATABASE_SSL=false
# Vercel/Supabase: usa "Transaction pooler" (puerto 6543) del botón Connect.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-REGION.pooler.supabase.com:6543/postgres
# DATABASE_SSL=true
# DATABASE_POOL_MAX=2
ADMIN_SESSION_DAYS=30
ACTIVATION_TOKEN_MINUTES=10
CSRF_SECRET=replace-with-at-least-32-random-characters
